{
  "name": "is-cdn-url",
  "description": "Check whether a URL belongs to a known CDN host (Cloudflare, Fastly, Akamai, CloudFront, and more).",
  "homepage": "https://github.com/Kikobeats/is-cdn-url",
  "version": "1.0.0",
  "main": "index.js",
  "author": {
    "name": "Kiko Beats",
    "email": "josefrancisco.verdu@gmail.com",
    "url": "https://kikobeats.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kikobeats/is-cdn-url.git"
  },
  "bugs": {
    "url": "https://github.com/Kikobeats/is-cdn-url/issues"
  },
  "keywords": [
    "cdn",
    "url",
    "uri",
    "check",
    "is",
    "cloudflare",
    "fastly",
    "akamai",
    "cloudfront",
    "hostname"
  ],
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "c8": "latest",
    "github-generate-release": "latest",
    "coveralls": "latest",
    "finepack": "latest",
    "git-authors-cli": "latest",
    "git-dirty": "latest",
    "simple-git-hooks": "latest",
    "nano-staged": "latest",
    "nyc": "latest",
    "standard": "latest",
    "standard-markdown": "latest",
    "standard-version": "latest",
    "ci-publish": "latest"
  },
  "engines": {
    "node": ">= 8"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "coverage": "nyc report --reporter=text-lcov | coveralls",
    "lint": "standard-markdown README.md && standard",
    "postrelease": "npm run release:tags && npm run release:github && ci-publish",
    "pretest": "npm run lint",
    "release": "standard-version -a",
    "release:github": "github-generate-release",
    "release:tags": "git push --follow-tags origin HEAD:master",
    "test": "c8 ava"
  },
  "license": "MIT",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit",
    "pre-commit": "npx nano-staged"
  },
  "nano-staged": {
    "package.json": [
      "finepack",
      "git add"
    ],
    "*.js": [
      "prettier-standard",
      "git add"
    ],
    "*.md": [
      "standard-markdown",
      "git add"
    ]
  }
}
